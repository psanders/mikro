# Mikro apiserver public loan-application intake endpoint.
# The Solicitud form POSTs submissions here (partial autosaves + final submit).
# Local dev example: http://localhost:4000/v1/applications
VITE_APPLICATIONS_URL=

# Meta pixel dataset ID (the web pixel "Mikro Website"). Leave empty to disable
# the pixel entirely — that's the right setting for local dev so test traffic
# stays out of the dataset. Production value is injected by the Deploy Site
# workflow from the VITE_META_PIXEL_ID repo secret.
VITE_META_PIXEL_ID=
