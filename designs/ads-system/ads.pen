          "fontFamily": "$ad-doc-font",
          "fontSize": 32,
          "fontWeight": "normal"
        },
        {
          "type": "frame",
          "id": "IIjZj",
          "name": "Block carousel-1x1 · 1440×1440",
          "layout": "vertical",
          "gap": 32,
