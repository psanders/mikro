{
  "manifest_version": 3,
  "name": "Mikro · Decisión",
  "version": "0.0.0",
  "description": "Herramienta del evaluador de Mikro: guarda los datos de Equifax y PrestamosCloud en Mikro, muestra el Mikro Score y permite rechazar o recomendar la aprobación.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "https://interactivereports.equifax.com/*",
        "https://portal.prestamoscloud.com/*"
      ],
      "js": ["main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://interactivereports.equifax.com/*",
        "https://portal.prestamoscloud.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "host_permissions": [],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"]
}
