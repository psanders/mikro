{
  "name": "@mikro/dashboard",
  "version": "0.0.0",
  "description": "Mikro founder dashboard - internal back-office app (desktop via Tauri + web)",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:local": "tauri build --config src-tauri/tauri.local.conf.json",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:e2e": "playwright test",
    "demo:renewal": "playwright test -c playwright.demo.config.ts"
  },
  "dependencies": {
    "@mikro/apiserver": "*",
    "@mikro/common": "*",
    "@tanstack/react-query": "^5.108.2",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-notification": "^2",
    "@tauri-apps/plugin-process": "^2",
    "@tauri-apps/plugin-updater": "^2",
    "@trpc/client": "^11.29.5",
    "@trpc/react-query": "^11.28.5",
    "lucide-react": "^1.77.0",
    "markdown-to-jsx": "^9.10.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@storybook/react-vite": "^10.6.8",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2",
    "@types/node": "^22",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.3.0",
    "storybook": "^10.4.6",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  }
}
