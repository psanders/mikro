{
  "name": "@mikro/creditscore",
  "version": "3.13.0",
  "description": "Experimental internal risk score from DataCrédito (Equifax RD) Interactive Reports data, plus a browser panel",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b --force && node .scripts/build-extension.mjs",
    "package": "tsc -b --force && node .scripts/build-extension.mjs --zip",
    "typecheck": "tsc --noEmit",
    "test": "mocha",
    "clean": "rm -rf dist chrome-extension *.zip"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "chai": "^6.2.2",
    "mocha": "^11.7.5",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
